DATABASE_URL=postgresql://rag:rag_local_dev@localhost:55432/rag
# Generate a random secret of at least 32 characters and configure the same value in Moodle.
# Keep the real value in the ignored .env file; never commit it.
MOODLE_SERVICE_SECRET=
# Local-only demo endpoint. Compose binds the service to 127.0.0.1; disable outside development.
LOCAL_DEMO_QUERY_ENABLED=true
AWS_PROFILE=jdesprout
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=200
MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=300
MAX_CHUNKS=1000
DB_CONNECT_TIMEOUT=3
BEDROCK_READ_TIMEOUT=30

# auto: Bedrock con fallback local; ollama: solo local; bedrock: solo AWS.
EMBEDDING_BACKEND=ollama
# CLI en el host; en Docker usar http://host.docker.internal:11434 o http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
# Vacío: reutilizar el modelo instalado de embeddings más pequeño.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_CONTEXT_LENGTH=2048
OLLAMA_DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=120
OLLAMA_PULL_TIMEOUT=1800
EMBEDDING_CIRCUIT_SECONDS=60
OLLAMA_SHADOW_ENABLED=true

OLLAMA_CHAT_MODEL=qwen2.5:3b
# -1 permite selección automática; 0 fuerza CPU si hace falta en otro equipo.
OLLAMA_CHAT_NUM_GPU=-1
OLLAMA_CHAT_TIMEOUT=120
